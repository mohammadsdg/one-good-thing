{
  "name": "one-good-thing",
  "version": "1.0.0",
  "private": true,
  "description": "A calm, private Telegram memory journal.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node --watch src/index.js",
    "migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "test": "node --import ./tests/setup.js tests/core.test.js && node --import ./tests/setup.js tests/mysql.integration.test.js",
    "check": "find src scripts tests -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "dotenv": "^16.4.7",
    "luxon": "^3.5.0",
    "mysql2": "^3.11.5",
    "node-cron": "^4.6.0",
    "pino": "^9.5.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.1"
  }
}
